---
import { Icon } from "astro-icon/components";
import {
  downloadTargets,
  type DownloadTarget,
  type GithubRelease,
} from "../lib/releases";

interface Props {
  href: string;
  release?: GithubRelease | null;
  target?: DownloadTarget;
  cta?: string;
  /** Override the target's default label (e.g. fallback copy). */
  label?: string;
}

const {
  href,
  release = null,
  target = "macos",
  cta = "download",
  label,
} = Astro.props;

const { icon, label: defaultLabel } = downloadTargets[target];
const version = release?.version ? `v${release.version}` : null;
---

<a
  href={href}
  data-no-dialog
  class="inline-flex w-fit items-center gap-1.5"
  data-cta={cta}
>
  <Icon name={icon} class="size-5 shrink-0 sm:size-4" />
  {label ?? defaultLabel}
  {version && <span class="text-faint tabular-nums">{version}</span>}
</a>
