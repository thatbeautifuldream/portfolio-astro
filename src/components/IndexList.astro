---
import { Icon } from "astro-icon/components";

interface Item {
  href: string;
  title: string;
  meta?: string;
  group?: string;
  external?: boolean;
  attrs?: Record<string, string>;
}

interface Props {
  title: string;
  items: Item[];
  class?: string;
}

const { title, items, class: className } = Astro.props;

const grouped = items.some((item) => item.group);
const groups = items.reduce<{ label?: string; items: Item[] }[]>(
  (acc, item) => {
    const last = acc.at(-1);
    if (last && last.label === item.group) last.items.push(item);
    else acc.push({ label: item.group, items: [item] });
    return acc;
  },
  [],
);
---

<section class:list={["min-w-0", className]}>
  <h2 class="section-title">{title}</h2>
  <ul role="list" class="index-list divide-border divide-y">
    {
      groups.map((group) => (
        <li>
          <ul role="list">
            {group.items.map((item, index) => (
              <li
                class:list={[
                  "after:border-border relative not-last:after:absolute not-last:after:right-0 not-last:after:bottom-0 not-last:after:border-b",
                  grouped
                    ? "not-last:after:left-12 sm:not-last:after:left-27"
                    : "not-last:after:left-0",
                ]}
              >
                <a
                  href={item.href}
                  {...(item.external && {
                    target: "_blank",
                    rel: "noopener noreferrer",
                  })}
                  {...item.attrs}
                  class:list={[
                    "group flex items-center justify-between gap-4 py-3 no-underline",
                    grouped && "pl-12 sm:pl-27",
                  ]}
                >
                  {index === 0 && group.label && (
                    <span class="text-faint absolute left-0 tabular-nums">
                      {group.label}
                    </span>
                  )}
                  <span class="inline-flex min-w-0 items-center gap-1.5">
                    <span class="min-w-0 truncate">{item.title}</span>
                    {item.external && (
                      <Icon
                        name="ri:arrow-right-up-line"
                        class="text-faint size-4 shrink-0 transition-transform group-hover:translate-x-0.5 sm:size-3.5"
                      />
                    )}
                  </span>
                  {item.meta && (
                    <span class="text-faint max-w-1/2 shrink-0 truncate tabular-nums">
                      {item.meta}
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</section>
