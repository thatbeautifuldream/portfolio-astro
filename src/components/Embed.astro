---
interface Props {
  src: string;
  title: string;
  caption: string;
}

const { src, title, caption } = Astro.props;
---

<figure data-wide>
  <iframe
    {src}
    {title}
    loading="lazy"
    class="border-rule block h-[32rem] w-full rounded-lg border"></iframe>
  <figcaption>{caption}</figcaption>
</figure>
