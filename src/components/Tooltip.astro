---
const { class: className } = Astro.props;
---

<div class:list={["tip-root relative", className]}>
  <slot />
  <div
    class="tip bg-foreground text-background pointer-events-none absolute top-0 left-0 overflow-hidden rounded-md px-2 py-1 text-sm whitespace-nowrap"
    aria-hidden="true"
    data-show="false"
  >
    <span class="tip-inner flex w-max items-baseline gap-1">
      <span class="tip-label font-medium tabular-nums"></span>
      <span class="tip-meta tabular-nums opacity-60"></span>
    </span>
  </div>
</div>

<style>
  .tip {
    translate: var(--tip-x, 0px) var(--tip-y, 0px);
    scale: 0.96;
    transform-origin: var(--tip-origin, 50%) 100%;
    opacity: 0;
    filter: blur(2px);
    transition:
      opacity 60ms ease-out,
      scale 60ms ease-out,
      filter 60ms ease-out,
      translate 180ms cubic-bezier(0.22, 1, 0.36, 1),
      width 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .tip[data-show="true"] {
    opacity: 1;
    scale: 1;
    filter: blur(0);
    transition:
      opacity 140ms ease-out,
      scale 140ms cubic-bezier(0.34, 1.36, 0.64, 1),
      filter 140ms ease-out,
      translate 180ms cubic-bezier(0.22, 1, 0.36, 1),
      width 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .tip {
      transition: none !important;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".tip-root").forEach((root) => {
    const tip = root.querySelector<HTMLElement>(":scope > .tip")!;
    const inner = tip.querySelector<HTMLElement>(".tip-inner")!;
    const label = tip.querySelector<HTMLElement>(".tip-label")!;
    const meta = tip.querySelector<HTMLElement>(".tip-meta")!;
    let active: Element | undefined;

    const hide = () => {
      tip.dataset.show = "false";
      active?.classList.remove("is-active");
      active = undefined;
    };

    const show = (event: Event) => {
      const target = (event.target as Element).closest<
        HTMLElement | SVGElement
      >("[data-tip]");
      if (!target || target === active) return;
      active?.classList.remove("is-active");
      active = target;
      target.classList.add("is-active");

      label.textContent = target.dataset.tip!;
      meta.textContent = target.dataset.tipMeta ?? "";
      meta.hidden = !target.dataset.tipMeta;
      const style = getComputedStyle(tip);
      const width = Math.ceil(
        inner.offsetWidth +
          parseFloat(style.paddingLeft) +
          parseFloat(style.paddingRight),
      );
      const bounds = root.getBoundingClientRect();
      const box = target.getBoundingClientRect();
      const center = box.left - bounds.left + box.width / 2;
      const x = Math.min(Math.max(center - width / 2, 0), bounds.width - width);
      const y = box.top - bounds.top - tip.offsetHeight - 8;

      const place = () => {
        tip.style.width = `${width}px`;
        tip.style.setProperty("--tip-x", `${x}px`);
        tip.style.setProperty("--tip-y", `${y}px`);
        tip.style.setProperty("--tip-origin", `${center - x}px`);
      };
      if (tip.dataset.show === "true") {
        place();
      } else {
        tip.style.transition = "none";
        place();
        void tip.offsetWidth;
        tip.style.transition = "";
      }
      tip.dataset.show = "true";
    };

    root.addEventListener("pointerover", show);
    root.addEventListener("focusin", show);
    root.addEventListener("pointerleave", hide);
    root.addEventListener("focusout", hide);
  });
</script>
