---
import { execSync } from "node:child_process";
import { Icon } from "astro-icon/components";
import { siteLinks } from "../data/portfolio";
import Tooltip from "./Tooltip.astro";
import {
  getLocale,
  isTranslated,
  localizePath,
  stripLocale,
  useTranslations,
} from "../i18n";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const path = stripLocale(Astro.url.pathname);
const otherLocale = locale === "hi" ? "en" : "hi";
const otherHref = localizePath(isTranslated(path) ? path : "/", otherLocale);

const repoUrl = "https://github.com/thatbeautifuldream/portfolio-astro";

let commitHash = process.env.VERCEL_GIT_COMMIT_SHA ?? "";
if (!commitHash) {
  try {
    commitHash = execSync("git rev-parse HEAD").toString().trim();
  } catch {
    commitHash = "";
  }
}
const shortHash = commitHash.slice(0, 7);

let commitMessage = process.env.VERCEL_GIT_COMMIT_MESSAGE ?? "";
if (!commitMessage) {
  try {
    commitMessage = execSync("git log -1 --format=%s").toString().trim();
  } catch {
    commitMessage = "";
  }
}
commitMessage = commitMessage.split("\n")[0]!;

const links = [
  { href: siteLinks.github.href, label: "GitHub", icon: "ri:github-fill" },
  {
    href: siteLinks.linkedin.href,
    label: "LinkedIn",
    icon: "ri:linkedin-box-fill",
  },
  { href: siteLinks.x.href, label: "X", icon: "ri:twitter-x-fill" },
  {
    href: siteLinks.chatgpt.href,
    label: siteLinks.chatgpt.label,
    icon: "ri:openai-fill",
  },
];
---

<footer class="grid gap-9 pb-20">
  <div aria-hidden="true" class="bg-rule h-px w-12.5"></div>
  <div class="text-faint grid gap-3">
    <Tooltip
      class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2"
    >
      <p class="tabular-nums">
        <span data-local-time data-separator={t.footer.timeSeparator}></span>{
          t.footer.location
        }
      </p>
      <a
        href={shortHash ? `${repoUrl}/commit/${commitHash}` : repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={shortHash ? t.footer.latestCommit(shortHash) : undefined}
        data-tip={commitMessage || undefined}
        class="hover:text-foreground flex items-center gap-1.5 font-normal tabular-nums no-underline"
      >
        <Icon name="ri:git-commit-line" class="size-5 shrink-0 sm:size-4" />
        {shortHash || t.footer.source}
      </a>
    </Tooltip>
    <Tooltip class="flex items-center justify-between gap-4">
      <ul role="list" class="flex items-center gap-x-4">
        {
          links.map(({ href, label, icon }) => (
            <li>
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                data-footer-social={label}
                aria-label={label}
                data-tip={label}
                class="hover:text-foreground flex font-normal no-underline"
              >
                <Icon name={icon} class="size-5 shrink-0 sm:size-4" />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="flex items-center gap-x-4">
        <a
          href={otherHref}
          hreflang={otherLocale}
          lang={otherLocale}
          aria-label={t.footer.switchLanguage}
          data-tip={t.footer.switchLanguage}
          class="hover:text-foreground flex font-normal no-underline"
        >
          <Icon name="ri:translate-2" class="size-5 shrink-0 sm:size-4" />
        </a>
        <button
          type="button"
          id="theme-toggle"
          data-tip={t.footer.toggleTheme}
          class="hover:text-foreground flex cursor-pointer"
        >
          <Icon
            name="ri:moon-line"
            class="size-5 shrink-0 sm:size-4 dark:hidden"
            role="img"
            aria-label={t.footer.darkMode}
          />
          <Icon
            name="ri:sun-line"
            class="size-5 shrink-0 not-dark:hidden sm:size-4"
            role="img"
            aria-label={t.footer.lightMode}
          />
        </button>
      </div>
    </Tooltip>
  </div>
</footer>

<script is:inline>
  document.querySelectorAll("footer [data-footer-social]").forEach((link) => {
    link.addEventListener("click", () => {
      window.posthog?.capture("footer_social_clicked", {
        platform: link.dataset.footerSocial,
      });
    });
  });

  (() => {
    const el = document.querySelector("[data-local-time]");
    if (!el) return;
    const format = new Intl.DateTimeFormat("en-US", {
      hour: "numeric",
      minute: "2-digit",
      timeZone: "Asia/Kolkata",
    });
    const tick = () => {
      el.textContent = `${format.format(new Date()).replace(" ", "").toLowerCase()}${el.dataset.separator}`;
    };
    tick();
    setInterval(tick, 30_000);
  })();

  (() => {
    let activeTransition = null;
    document.getElementById("theme-toggle")?.addEventListener("click", () => {
      const root = document.documentElement;
      const next = root.classList.contains("dark") ? "light" : "dark";
      window.posthog?.capture("theme_toggled", { theme: next });
      const apply = () => {
        root.classList.toggle("dark", next === "dark");
        localStorage.setItem("theme", next);
      };

      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!document.startViewTransition || reduced) {
        apply();
        return;
      }

      root.classList.add("theme-transition");
      const transition = document.startViewTransition(apply);
      activeTransition = transition;
      // A rapid second toggle skips this transition and fires its finished
      // callback while the new one is still running — only the latest
      // transition may clean up the class, or the page-transition CSS takes
      // over mid-wipe.
      transition.finished.finally(() => {
        if (activeTransition === transition) {
          activeTransition = null;
          root.classList.remove("theme-transition");
        }
      });
    });
  })();
</script>
