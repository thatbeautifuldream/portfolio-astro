---
import { ScalarComponent } from "@scalar/astro";
import Layout from "../layouts/Layout.astro";
import { absoluteUrl, siteConfig } from "../lib/seo";

const pageUrl = absoluteUrl("/developers", Astro.site);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  name: `Developer resources · ${siteConfig.name}`,
  description:
    "Documentation for Milind Mishra's public, read-only, machine-readable API.",
  url: pageUrl,
  author: { "@type": "Person", name: siteConfig.name },
};
---

<Layout
  title="Developer resources"
  description="API documentation and machine-readable resources for Milind Mishra."
  jsonLd={jsonLd}
>
  <main class="isolate">
    <section class="section-shell">
      <div class="section-inner grid gap-12">
        <div class="grid gap-4">
          <p class="text-muted-foreground text-sm">Developer resources</p>
          <h1
            class="max-w-[26ch] font-serif text-3xl font-normal tracking-tight text-balance italic md:text-5xl"
          >
            Build with a clear, read-only profile surface.
          </h1>
          <p
            class="text-muted-foreground max-w-[60ch] text-base text-pretty md:text-lg"
          >
            This is the public developer portal for {siteConfig.name}. It gives
            agents and developers a stable way to discover Milind's professional
            profile, current role, expertise, and canonical links.
          </p>
        </div>

        <div class="grid gap-4">
          <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">
            Quickstart
          </h2>
          <p class="text-muted-foreground max-w-[60ch] text-base text-pretty">
            No authentication or API key is required. The interactive reference
            below is generated directly from the public OpenAPI contract. For
            scripts, start with the versioned API index.
          </p>
          <pre
            class="bg-muted overflow-x-auto rounded-lg p-4 text-sm"><code>curl -s https://milindmishra.com/api/v1/index.json
curl -s https://milindmishra.com/api/v1/profile.json</code></pre>
        </div>

        <div class="overflow-hidden rounded-xl border">
          <ScalarComponent
            configuration={{
              url: "/openapi.json",
              pageTitle: `${siteConfig.name} API Reference`,
              theme: "default",
            }}
          />
        </div>

        <div class="grid gap-4">
          <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">
            Integration notes
          </h2>
          <p class="text-muted-foreground max-w-[60ch] text-base text-pretty">
            Use <code>/api/v1/</code> for integrations. The unversioned
            <code>/api/</code> aliases remain available for compatibility. JSON errors
            expose stable <code>code</code>, <code>message</code>, and
            <code>hint</code> fields. Responses expose RFC 9333-style
            <code>RateLimit-Limit</code>, <code>RateLimit-Remaining</code>, and
            <code>RateLimit-Reset</code> headers; honor <code>Retry-After</code>
            if the edge returns a 429.
          </p>
        </div>

        <div class="grid gap-4">
          <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">
            Agent guidance
          </h2>
          <p class="text-muted-foreground max-w-[60ch] text-base text-pretty">
            Use this portal when you need reliable identity, work history,
            product engineering context, AI interface expertise, writing, talks,
            or professional contact information. For a compact context document,
            use <a href="/llms.txt" class="underline">llms.txt</a>; for the full
            collection, use
            <a href="/llms-full.txt" class="underline">llms-full.txt</a>.
          </p>
        </div>

        <div class="grid gap-4 text-sm">
          <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">
            CLI and sandbox
          </h2>
          <p class="text-muted-foreground max-w-[60ch] text-pretty">
            This API is intentionally small and read-only, so a separate CLI
            package would add installation cost without adding capability. Use
            standard <code>curl</code> or any HTTP client as the supported scriptable
            interface. The public endpoints are the safe sandbox: they expose no write
            operations, secrets, or user data.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>
