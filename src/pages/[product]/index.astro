---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import Carousel from "../../components/Carousel.astro";
import DownloadButton from "../../components/DownloadButton.astro";
import { absoluteUrl, siteConfig } from "../../lib/seo";
import { downloadTargets, getLatestRelease } from "../../lib/releases";

export async function getStaticPaths() {
  const products = await getCollection("products");
  return products.map((product) => ({
    params: { product: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);

const data = product.data;
const supportPath = `/${product.id}/support`;
const marketingPath = `/${product.id}`;
const downloadPath = `/${product.id}/download`;
const marketingUrl = absoluteUrl(marketingPath, Astro.site);

// Products with a `downloadRepo` resolve their newest GitHub release at build
// time so the marketing page can show the version + pre-release badge and the
// `/{product}/download` route can redirect straight to the installer asset.
const release = data.downloadRepo
  ? await getLatestRelease(data.downloadRepo, data.downloadTarget)
  : null;
const downloadLabel = downloadTargets[data.downloadTarget].label;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: data.name,
    description: data.description,
    url: marketingUrl,
    applicationCategory: data.category,
    operatingSystem: data.platforms.join(", "),
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
    ...(data.appStoreUrl
      ? { downloadUrl: data.appStoreUrl }
      : release?.assetUrl
        ? { downloadUrl: release.assetUrl }
        : {}),
    featureList: data.features.map((f) => f.title),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: siteConfig.shortName,
        item: absoluteUrl("/", Astro.site),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: data.name,
        item: marketingUrl,
      },
    ],
  },
];
---

<Layout
  title={data.name}
  description={data.tagline}
  canonical={marketingUrl}
  keywords={data.keywords}
  image={`/og/product/${product.id}.png`}
  jsonLd={jsonLd}
>
  <main class="stagger grid gap-12">
    <div class="grid gap-4">
      <PageHeader title={data.name} meta={data.tagline} />
      <p class="text-pretty">{data.description}</p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        {
          data.appStoreUrl && (
            <a
              href={data.appStoreUrl}
              data-no-dialog
              class="inline-flex items-center gap-1.5"
              data-cta="app-store"
            >
              <Icon name="ri:apple-fill" class="size-5 shrink-0 sm:size-4" />
              Download on the App Store
            </a>
          )
        }
        {
          data.downloadRepo && (
            <DownloadButton
              href={downloadPath}
              release={release}
              target={data.downloadTarget}
              cta="download"
            />
          )
        }
        <a href={supportPath} data-cta="support">Support</a>
      </div>
      <p class="text-faint">
        {data.pricing} · {data.platforms.join(" · ")}
        {release?.prerelease && " · Pre-release"}
      </p>
    </div>

    {
      data.screenshotUrls.length > 0 && (
        <Carousel
          slides={data.screenshotUrls.map((src) => ({
            src,
            alt: `${data.name} screenshot`,
            width: data.screenshotSize.width,
            height: data.screenshotSize.height,
          }))}
        />
      )
    }

    {
      data.features.length > 0 && (
        <section class="grid gap-4">
          <h2 class="section-title">What it does</h2>
          <ul role="list" class="grid gap-6">
            {data.features.map((feature) => (
              <li class="grid gap-1">
                <h3 class="font-semibold">{feature.title}</h3>
                <p class="text-muted-foreground text-pretty">
                  {feature.description}
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      data.privacyPoints.length > 0 && (
        <section class="grid gap-4">
          <h2 class="section-title">Private by design</h2>
          <div class="prose">
            <ul>
              {data.privacyPoints.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <div class="prose min-w-0">
      <Content />
    </div>

    <footer class="grid gap-2">
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        {
          data.downloadRepo && (
            <a href={downloadPath} data-cta="download-footer">
              {downloadLabel}
            </a>
          )
        }
        <a href={supportPath} data-cta="support-footer">
          Support and documentation
        </a>
      </div>
      <p class="text-faint text-pretty">
        Built by {siteConfig.name}. {data.pricing}. No ads, no tracking, no
        account.
      </p>
    </footer>
  </main>
</Layout>

<script is:inline>
  document.querySelectorAll("[data-cta]").forEach((link) => {
    link.addEventListener("click", () => {
      window.posthog?.capture("product_cta_clicked", {
        product: document.title,
        cta: link.dataset.cta,
      });
    });
  });
</script>
