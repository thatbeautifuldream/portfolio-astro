---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { absoluteUrl } from "../../lib/seo";

export async function getStaticPaths() {
  const products = await getCollection("products");
  return products.map((product) => ({
    params: { product: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const data = product.data;

const privacyPath = `/${product.id}/privacy`;
const marketingPath = `/${product.id}`;
const supportPath = `/${product.id}/support`;
const privacyUrl = absoluteUrl(privacyPath, Astro.site);

const policyDate = data.policyUpdatedAt
  ? data.policyUpdatedAt.toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;

const privacyHeadline = data.privacyHeadline ?? "Private by design.";

const privacyOverview =
  data.privacyOverview ??
  `${data.name} is built privacy-first. The sections below describe exactly what is collected, what stays on your device, and what, if anything, leaves it.`;
const privacyRetention =
  data.privacyRetention ??
  `Anything ${data.name} stores locally lives only on your device. Uninstalling ${data.name} removes it immediately. There is no server-side copy to delete because ${data.name} does not run a server.`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `Privacy Policy · ${data.name}`,
  description: `How ${data.name} handles your data and privacy.`,
  url: privacyUrl,
  isPartOf: {
    "@type": "SoftwareApplication",
    name: data.name,
    url: absoluteUrl(marketingPath, Astro.site),
  },
  ...(data.policyUpdatedAt
    ? { dateModified: data.policyUpdatedAt.toISOString() }
    : {}),
};
---

<Layout
  title={`Privacy · ${data.name}`}
  description={`How ${data.name} handles your data and privacy.`}
  canonical={privacyUrl}
  keywords={[...data.keywords, "privacy", "policy"]}
  image={`/og/product/${product.id}.png`}
  jsonLd={jsonLd}
>
  <main class="stagger grid gap-12">
    <div class="grid gap-4">
      <PageHeader
        title={privacyHeadline}
        meta={policyDate
          ? `Privacy policy · Updated ${policyDate}`
          : "Privacy policy"}
      />
      <p class="text-pretty">{data.description}</p>
    </div>

    <section class="grid gap-4">
      <h2 class="section-title">Overview</h2>
      <p class="text-pretty">{privacyOverview}</p>
    </section>

    <section class="grid gap-4">
      <h2 class="section-title">Data we collect</h2>
      <p class="text-pretty">
        {
          data.dataCollected ??
            "None. This app does not collect, transmit, or share any personal data."
        }
      </p>
    </section>

    {
      data.privacyPoints.length > 0 && (
        <section class="grid gap-4">
          <h2 class="section-title">How your data is processed</h2>
          <div class="prose">
            <ul>
              {data.privacyPoints.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {
      data.permissions.length > 0 && (
        <section class="grid gap-4">
          <h2 class="section-title">Permissions</h2>
          <div class="prose">
            <ul>
              {data.permissions.map((perm) => (
                <li>{perm}</li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <section class="grid gap-4">
      <h2 class="section-title">Third-party services</h2>
      {
        data.thirdParties.length > 0 ? (
          <div class="prose">
            <ul>
              {data.thirdParties.map((party) => (
                <li>{party}</li>
              ))}
            </ul>
          </div>
        ) : (
          <p class="text-pretty">
            {data.name} does not use any third-party services. No analytics, no
            crash reporting, no advertising SDKs, no servers.
          </p>
        )
      }
    </section>

    <section class="grid gap-4">
      <h2 class="section-title">Children's privacy</h2>
      <p class="text-pretty">
        {
          data.analytics
            ? `${data.name} is not directed at children and does not knowingly collect personal data from anyone under 13. There are no accounts, no sign-up flows, and no age-gated features.`
            : `${data.name} does not collect any data from anyone, including children. There are no accounts, no sign-up flows, and no age-gated features.`
        }
      </p>
    </section>

    <section class="grid gap-4">
      <h2 class="section-title">Data retention and deletion</h2>
      <p class="text-pretty">{privacyRetention}</p>
    </section>

    <section class="grid gap-4">
      <h2 class="section-title">Changes to this policy</h2>
      <p class="text-pretty">
        If {data.name} ever starts doing something new with your data, this page will
        be updated before that change ships, and the "last updated" date above will
        reflect it.
      </p>
    </section>

    <section class="grid gap-4">
      <h2 class="section-title">Questions</h2>
      <p class="text-pretty">
        If anything here is unclear, email and you'll get a real reply from a
        real person.
      </p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        {
          data.supportEmail && (
            <a
              href={`mailto:${data.supportEmail}?subject=${encodeURIComponent(`${data.name} privacy question`)}`}
              data-contact="email"
            >
              {data.supportEmail}
            </a>
          )
        }
        <a href={supportPath}>Read the support page</a>
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  document.querySelectorAll("[data-contact='email']").forEach((link) => {
    link.addEventListener("click", () => {
      window.posthog?.capture("product_privacy_contacted", {
        product: document.title,
      });
    });
  });
</script>
