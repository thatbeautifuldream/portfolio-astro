---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { absoluteUrl } from "../../lib/seo";

export async function getStaticPaths() {
  const products = await getCollection("products");
  return products.map((product) => ({
    params: { product: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const data = product.data;
const supportPath = `/${product.id}/support`;
const supportUrl = absoluteUrl(supportPath, Astro.site);

const jsonLd =
  data.faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        url: supportUrl,
        mainEntity: data.faq.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: {
            "@type": "Answer",
            text: item.answer,
          },
        })),
      }
    : undefined;
---

<Layout
  title={`Support · ${data.name}`}
  description={`Support, troubleshooting, and frequently asked questions for ${data.name}.`}
  canonical={supportUrl}
  keywords={[...data.keywords, "support", "help", "faq"]}
  image={`/og/product/${product.id}.png`}
  jsonLd={jsonLd}
>
  <main class="stagger grid gap-12">
    <div class="grid gap-4">
      <PageHeader title={`${data.name} support`} meta={data.tagline} />
      <p class="text-pretty">{data.description}</p>
    </div>

    {
      data.faq.length > 0 && (
        <section class="grid">
          <h2 class="section-title">Frequently asked questions</h2>
          <div class="divide-border grid divide-y">
            {data.faq.map((item) => (
              <details class="group py-3">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 marker:hidden">
                  <span>{item.question}</span>
                  <Icon
                    name="ri:add-line"
                    class="text-faint size-5 shrink-0 transition-transform group-open:rotate-45 sm:size-4"
                  />
                </summary>
                <p class="text-muted-foreground pt-2 text-pretty">
                  {item.answer}
                </p>
              </details>
            ))}
          </div>
        </section>
      )
    }

    {
      data.permissions.length > 0 && (
        <section class="grid gap-4">
          <h2 class="section-title">Permissions</h2>
          <div class="prose">
            <ul>
              {data.permissions.map((perm) => (
                <li>{perm}</li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {
      data.requirements.length > 0 && (
        <section class="grid gap-4">
          <h2 class="section-title">Requirements</h2>
          <div class="prose">
            <ul>
              {data.requirements.map((req) => (
                <li>{req}</li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {
      data.privacyPoints.length > 0 && (
        <section class="grid gap-4">
          <h2 class="section-title">Privacy</h2>
          <div class="prose">
            <ul>
              {data.privacyPoints.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <section class="grid gap-4">
      <h2 class="section-title">Get in touch</h2>
      <p class="text-pretty">
        Still stuck? Email and you'll get a real reply from a real person,
        usually within a day.
      </p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        {
          data.supportEmail && (
            <a
              href={`mailto:${data.supportEmail}?subject=${encodeURIComponent(`${data.name} support`)}`}
              data-contact="email"
            >
              {data.supportEmail}
            </a>
          )
        }
        {
          data.supportLinks.map((link) => (
            <a href={link.href} data-no-dialog>
              {link.label}
            </a>
          ))
        }
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  document.querySelectorAll("[data-contact='email']").forEach((link) => {
    link.addEventListener("click", () => {
      window.posthog?.capture("product_support_contacted", {
        product: document.title,
      });
    });
  });
</script>
