---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import DownloadButton from "../../components/DownloadButton.astro";
import PageHeader from "../../components/PageHeader.astro";
import { absoluteUrl } from "../../lib/seo";
import {
  downloadTargets,
  getLatestRelease,
  repoReleasesUrl,
  repoTagUrl,
} from "../../lib/releases";

export async function getStaticPaths() {
  const products = await getCollection("products");
  return products
    .filter((product) => product.data.downloadRepo)
    .map((product) => ({
      params: { product: product.id },
      props: { product },
    }));
}

const { product } = Astro.props;
const data = product.data;

const downloadRepo = data.downloadRepo!;
const release = await getLatestRelease(downloadRepo, data.downloadTarget);
const { label: downloadLabel, extension } =
  downloadTargets[data.downloadTarget];
const platformName = data.downloadTarget === "android" ? "Android" : "macOS";

const marketingPath = `/${product.id}`;
const downloadPath = `/${product.id}/download`;
const downloadUrl = absoluteUrl(downloadPath, Astro.site);

// Prefer the resolved installer asset; if the build-time fetch was rate limited
// or the release shipped no matching installer, fall back to the releases index
// so the user still lands somewhere useful instead of a dead link.
const target = release?.assetUrl ?? repoReleasesUrl(downloadRepo);
const isFallback = !release?.assetUrl;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `Download · ${data.name}`,
  description: `Download the latest build of ${data.name} for ${platformName}.`,
  url: downloadUrl,
  isPartOf: {
    "@type": "SoftwareApplication",
    name: data.name,
    url: absoluteUrl(marketingPath, Astro.site),
  },
};
---

<Layout
  title={`Download · ${data.name}`}
  description={`Download the latest build of ${data.name} for ${platformName}.`}
  canonical={downloadUrl}
  keywords={[
    ...data.keywords,
    "download",
    platformName.toLowerCase(),
    extension.slice(1),
  ]}
  image={`/og/product/${product.id}.png`}
  jsonLd={jsonLd}
>
  <Fragment slot="head-extra">
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </Fragment>

  <main class="stagger grid gap-12">
    <div class="grid gap-4">
      <PageHeader title="Starting your download" meta={data.name} />
      <p class="text-pretty">
        Your {data.downloadTarget === "android" ? "device" : "Mac"} should start pulling
        down {data.name} in a moment. If nothing happens, use the link below.
      </p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <DownloadButton
          href={target}
          release={release}
          target={data.downloadTarget}
          cta="download-direct"
          label={isFallback ? "View releases on GitHub" : downloadLabel}
        />
        <a
          href={release
            ? repoTagUrl(downloadRepo, release.tag)
            : repoReleasesUrl(downloadRepo)}
          data-no-dialog
        >
          Release notes
        </a>
      </div>
      {
        release && (
          <p class="text-faint tabular-nums">
            {release.tag} ·{" "}
            {new Date(release.publishedAt).toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
            {release.prerelease && " · Pre-release"}
          </p>
        )
      }
    </div>

    {
      data.platforms.length > 0 && (
        <p class="text-muted-foreground text-pretty">
          Built for {data.platforms.join(" · ")}.{" "}
          {data.downloadRepo && "Open source on GitHub."}
        </p>
      )
    }
  </main>
</Layout>

<script is:inline define:vars={{ target }}>
  document.querySelectorAll("[data-cta='download-direct']").forEach((link) => {
    link.addEventListener("click", () => {
      window.posthog?.capture("product_cta_clicked", {
        product: document.title,
        cta: "download-direct",
      });
    });
  });
  try {
    window.location.replace(target);
  } catch {
    window.location.href = target;
  }
</script>
