---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import IndexList from "../components/IndexList.astro";
---

<Layout title="Not found" description="This page could not be found.">
  <main class="stagger grid gap-12">
    <article class="grid gap-4">
      <PageHeader title="This page wandered off." meta="404" />
      <p class="text-pretty">
        The page you're looking for doesn't exist or has moved. Let's get you
        back on track.
      </p>
    </article>
    <section class="grid min-w-0 gap-4">
      <h2 class="section-title">Agent recovery links</h2>
      <div class="prose min-w-0">
        <pre><code># Not found

Try the homepage, sitemap, Markdown content, or API docs:

- [Home](/)
- [Sitemap](/sitemap-index.xml)
- [Machine-readable context](/llms.txt)
- [API documentation](/docs)</code></pre>
      </div>
    </section>
    <IndexList
      title="Go somewhere"
      items={[
        { href: "/", title: "Home" },
        { href: "/blog", title: "Read the blog" },
        { href: "/docs", title: "API documentation" },
      ]}
    />
  </main>
</Layout>
