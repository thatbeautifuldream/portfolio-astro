---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { absoluteUrl, siteConfig } from "../lib/seo";
import { getLocale, localizePath, useTranslations } from "../i18n";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale).privacy;
const pageUrl = absoluteUrl(localizePath("/privacy", locale), Astro.site);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `${t.title} · ${siteConfig.name}`,
  description: t.description,
  url: pageUrl,
};
---

<Layout title={t.title} description={t.description} jsonLd={jsonLd}>
  <main class="stagger grid gap-12">
    <PageHeader title={t.title} meta={t.meta} />
    <section class="grid gap-4">
      <h2 class="section-title">{t.collects}</h2>
      <p class="text-pretty">{t.collectsBody}</p>
    </section>
    <section class="grid gap-4">
      <h2 class="section-title">{t.contactInfo}</h2>
      <p class="text-pretty">
        {t.contactInfoBody[0]}<a href={localizePath("/contact", locale)}
          >{t.contactPage}</a
        >{t.contactInfoBody[1]}
      </p>
    </section>
    <section class="grid gap-4">
      <h2 class="section-title">{t.choices}</h2>
      <p class="prose text-pretty">
        {t.choicesBody[0]}<code>PUBLIC_DISABLE_ANALYTICS=true</code>{
          t.choicesBody[1]
        }
      </p>
      <p class="text-muted-foreground text-pretty">{t.note}</p>
    </section>
  </main>
</Layout>
