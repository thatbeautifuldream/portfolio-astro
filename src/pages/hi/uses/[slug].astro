---
import Page from "../../uses/[slug].astro";
import { getLocalizedCollection } from "../../../i18n/content";

export async function getStaticPaths() {
  const items = await getLocalizedCollection("uses", "hi");
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}
---

<Page {...Astro.props} />
