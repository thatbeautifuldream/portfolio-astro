---
import Page from "../../gist/[slug].astro";
import { getLocalizedCollection } from "../../../i18n/content";

export async function getStaticPaths() {
  const gists = await getLocalizedCollection("gists", "hi");
  return gists.map((gist) => ({ params: { slug: gist.id }, props: { gist } }));
}
---

<Page {...Astro.props} />
