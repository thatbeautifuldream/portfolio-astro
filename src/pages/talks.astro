---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import IndexList from "../components/IndexList.astro";
import { talks, contributions } from "../data/portfolio";
import { absoluteUrl, buildPersonRef, siteConfig } from "../lib/seo";

const pageUrl = absoluteUrl("/talks", Astro.site);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `Talks · ${siteConfig.name}`,
  description:
    "Talks on React, motion systems, interface architecture, and AI for frontend engineers.",
  url: pageUrl,
  author: buildPersonRef(Astro.site),
  hasPart: talks.map((talk) => ({
    "@type": "Event",
    name: talk.title,
    description: talk.description,
    startDate: talk.date,
    location: { "@type": "Place", name: talk.event },
    url: talk.href,
    performer: buildPersonRef(Astro.site),
  })),
};
---

<Layout
  title="Talks"
  description="Talks on React, motion systems, interface architecture, and AI for frontend engineers."
  jsonLd={jsonLd}
>
  <main class="stagger grid gap-12">
    <article class="grid gap-4">
      <PageHeader
        title="Talks"
        meta="I share what I learn because it forces me to learn it deeper."
      />
      <p class="text-pretty">
        These talks come from things I ran into firsthand and couldn't stop
        thinking about. Sharing them publicly keeps me honest, helps others
        experiment sooner, and sharpens my own understanding in a way that
        building alone never could.
      </p>
    </article>

    <IndexList
      title="Talks"
      items={talks.map((talk) => ({
        href: talk.href,
        title: talk.title,
        meta: talk.event,
        group: talk.date.slice(-4),
        external: true,
        attrs: { "data-talk-title": talk.title, "data-talk-event": talk.event },
      }))}
    />

    <section class="grid gap-4">
      <h2 class="section-title">Open source</h2>
      <p class="text-pretty">
        While building AI chat interfaces at Merlin, the core challenge was
        rendering streamed markdown responses cleanly. That led me to
        Streamdown, Vercel's open source markdown renderer built for AI
        streaming. These contributions came from real product gaps, not side
        quests.
      </p>
    </section>

    <IndexList
      title="Contributions"
      items={contributions.map((item) => ({
        href: item.href,
        title: item.title,
        external: true,
        attrs: { "data-contribution-title": item.title },
      }))}
    />
  </main>
</Layout>

<script is:inline>
  document.querySelectorAll("[data-talk-title]").forEach((link) => {
    link.addEventListener("click", () => {
      window.posthog?.capture("talk_clicked", {
        talk_title: link.dataset.talkTitle,
        talk_event: link.dataset.talkEvent,
      });
    });
  });

  document.querySelectorAll("[data-contribution-title]").forEach((link) => {
    link.addEventListener("click", () => {
      window.posthog?.capture("contribution_clicked", {
        contribution_title: link.dataset.contributionTitle,
      });
    });
  });
</script>
