---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import IndexList from "../components/IndexList.astro";
import { talks, contributions } from "../data/portfolio";
import { absoluteUrl, buildPersonRef, siteConfig } from "../lib/seo";
import { getLocale, localizePath, useTranslations } from "../i18n";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale).talks;
const pageUrl = absoluteUrl(localizePath("/talks", locale), Astro.site);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${t.title} · ${siteConfig.name}`,
  description: t.description,
  url: pageUrl,
  author: buildPersonRef(Astro.site),
  hasPart: talks.map((talk) => ({
    "@type": "Event",
    name: talk.title,
    description: talk.description,
    startDate: talk.date,
    location: { "@type": "Place", name: talk.event },
    url: talk.href,
    performer: buildPersonRef(Astro.site),
  })),
};
---

<Layout title={t.title} description={t.description} jsonLd={jsonLd}>
  <main class="stagger grid gap-12">
    <article class="grid gap-4">
      <PageHeader title={t.title} meta={t.meta} />
      <p class="text-pretty">{t.body}</p>
    </article>

    <IndexList
      title={t.title}
      items={talks.map((talk) => ({
        href: talk.href,
        title: talk.title,
        meta: talk.event,
        group: talk.date.slice(-4),
        external: true,
        attrs: { "data-talk-title": talk.title, "data-talk-event": talk.event },
      }))}
    />

    <section class="grid gap-4">
      <h2 class="section-title">{t.openSource}</h2>
      <p class="text-pretty">{t.openSourceBody}</p>
    </section>

    <IndexList
      title={t.contributions}
      items={contributions.map((item) => ({
        href: item.href,
        title: item.title,
        external: true,
        attrs: { "data-contribution-title": item.title },
      }))}
    />
  </main>
</Layout>

<script is:inline>
  document.querySelectorAll("[data-talk-title]").forEach((link) => {
    link.addEventListener("click", () => {
      window.posthog?.capture("talk_clicked", {
        talk_title: link.dataset.talkTitle,
        talk_event: link.dataset.talkEvent,
      });
    });
  });

  document.querySelectorAll("[data-contribution-title]").forEach((link) => {
    link.addEventListener("click", () => {
      window.posthog?.capture("contribution_clicked", {
        contribution_title: link.dataset.contributionTitle,
      });
    });
  });
</script>
