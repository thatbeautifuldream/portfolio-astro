---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import CodeCopy from "../../components/CodeCopy.astro";
import PageHeader from "../../components/PageHeader.astro";
import { absoluteUrl, buildPersonRef } from "../../lib/seo";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  author: buildPersonRef(Astro.site),
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
};
---

<Layout
  title={post.data.title}
  description={post.data.description}
  canonical={absoluteUrl(`/blog/${post.id}`, Astro.site)}
  image={`/og/${post.id}.png`}
  jsonLd={jsonLd}
>
  <main>
    <article class="stagger grid min-w-0 gap-8">
      <PageHeader
        title={post.data.title}
        meta={`${post.data.category} · ${formatDate(post.data.date)}`}
      />
      {
        post.data.coverImage && (
          <Image
            src={post.data.coverImage}
            alt=""
            class="w-full rounded-lg outline-1 -outline-offset-1 outline-black/5 dark:outline-white/10"
          />
        )
      }
      <div class="prose min-w-0">
        <Content />
      </div>
    </article>
  </main>
  <CodeCopy />
</Layout>

<script is:inline define:vars={{ slug: post.id, title: post.data.title }}>
  const milestones = [25, 50, 75, 100];
  const fired = new Set();
  function onScroll() {
    const doc = document.documentElement;
    const scrollable = doc.scrollHeight - innerHeight;
    const percent = scrollable <= 0 ? 100 : (scrollY / scrollable) * 100;
    for (const m of milestones) {
      if (percent >= m && !fired.has(m)) {
        fired.add(m);
        window.posthog?.capture("blog_read_depth", {
          post_slug: slug,
          post_title: title,
          depth: m,
        });
      }
    }
    if (fired.size === milestones.length) {
      removeEventListener("scroll", onScroll);
    }
  }
  addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>
