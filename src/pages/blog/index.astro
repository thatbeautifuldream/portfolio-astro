---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import IndexList from "../../components/IndexList.astro";
import { absoluteUrl, buildPersonRef, siteConfig } from "../../lib/seo";
import { getLocale, localizePath, useTranslations } from "../../i18n";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale).blog;

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: `${siteConfig.shortName} - Blog`,
  description: t.description,
  url: absoluteUrl(localizePath("/blog", locale), Astro.site),
  author: buildPersonRef(Astro.site),
};
---

<Layout title={t.title} description={t.description} jsonLd={jsonLd}>
  <main class="stagger grid gap-12">
    <PageHeader title={t.heading} meta={t.meta} />
    <IndexList
      title={t.posts}
      items={posts.map((post) => ({
        href: `/blog/${post.id}`,
        title: post.data.title,
        meta: post.data.date.toLocaleDateString("en-GB", {
          day: "2-digit",
          month: "2-digit",
        }),
        group: String(post.data.date.getFullYear()),
        attrs: { "data-post-title": post.data.title },
      }))}
    />
  </main>
</Layout>

<script is:inline>
  document.querySelectorAll('a[href^="/blog/"]').forEach((link) => {
    link.addEventListener("click", () => {
      window.posthog?.capture("blog_post_clicked", {
        post_slug: link.getAttribute("href").replace("/blog/", ""),
        post_title: link.dataset.postTitle ?? null,
      });
    });
  });
</script>
