---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { hostname } from "../../data/portfolio";
import { absoluteUrl, buildPersonRef } from "../../lib/seo";

export async function getStaticPaths() {
  const items = await getCollection("uses");
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: item.data.title,
  description: item.data.description,
  author: buildPersonRef(Astro.site),
  datePublished: item.data.date.toISOString(),
  dateModified: item.data.date.toISOString(),
};
---

<Layout
  title={item.data.title}
  description={item.data.description}
  canonical={absoluteUrl(`/uses/${item.id}`, Astro.site)}
  jsonLd={jsonLd}
>
  <main>
    <article class="stagger grid min-w-0 gap-8">
      <PageHeader title={item.data.title} meta={item.data.category} />
      <div class="grid gap-4">
        <p class="text-muted-foreground text-pretty">
          {item.data.description}
        </p>
        {
          item.data.url && (
            <p>
              <a href={item.data.url} target="_blank" rel="noopener noreferrer">
                {hostname(item.data.url)}
              </a>
            </p>
          )
        }
      </div>
      {
        item.data.coverImage && (
          <Image
            src={item.data.coverImage}
            alt=""
            class="w-full rounded-lg outline-1 -outline-offset-1 outline-black/5 dark:outline-white/10"
          />
        )
      }
      <div class="prose min-w-0">
        <Content />
      </div>
    </article>
  </main>
</Layout>
