---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { absoluteUrl, buildPersonSchema, siteConfig } from "../lib/seo";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: `About · ${siteConfig.name}`,
  description: siteConfig.description,
  url: absoluteUrl("/about", Astro.site),
  mainEntity: buildPersonSchema(Astro.site),
};
---

<Layout title="About" description={siteConfig.description} jsonLd={jsonLd}>
  <main class="stagger grid gap-12">
    <article class="grid gap-4">
      <PageHeader
        title="About"
        meta="Product thinking, implemented with care."
      />
      <p class="text-pretty">
        I'm {siteConfig.name}, a product engineer based in
        {siteConfig.location.city}, {siteConfig.location.country}. I work at {
          siteConfig.currentRole.company
        } as a {siteConfig.currentRole.title}, building browser agent
        experiences and chat interfaces that make ambient AI useful in everyday
        workflows.
      </p>
      <p class="text-pretty">
        My strongest work sits between product judgment and implementation
        discipline. I care about the problem a feature solves, the system that
        supports it, the words that make it understandable, and the interaction
        details that make it feel trustworthy. I build with React, TypeScript,
        design systems, motion, and increasingly agentic flows where software
        can help people complete meaningful work rather than merely generate
        output.
      </p>
      <p class="text-pretty">
        This site is a durable record of that work: products, talks, writing,
        experiments, and practical code. It is also designed to be legible to
        people and machines. The developer portal, OpenAPI contract, JSON
        profile, and LLM context files provide direct paths for agents that need
        accurate identity, experience, or contact information.
      </p>
      <p class="text-pretty">
        For professional conversations, send a specific note through the <a
          href="/contact">contact page</a
        >. I am open to thoughtful product engineering, design engineering, and
        AI interface work with teams that value craft and clarity.
      </p>
    </article>
  </main>
</Layout>
