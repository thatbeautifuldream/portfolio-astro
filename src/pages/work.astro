---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { roles } from "../data/portfolio";
import { absoluteUrl, buildPersonRef, siteConfig } from "../lib/seo";
import { getLocale, localizePath, useTranslations } from "../i18n";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale).work;
const pageUrl = absoluteUrl(localizePath("/work", locale), Astro.site);
const localizedRoles = roles.map((role) => ({
  ...role,
  ...t.roles[role.company],
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${t.schemaName} · ${siteConfig.name}`,
  description: t.description,
  url: pageUrl,
  author: buildPersonRef(Astro.site),
  hasPart: localizedRoles.map((role) => ({
    "@type": "OrganizationRole",
    roleName: role.role,
    worksFor: { "@type": "Organization", name: role.company },
  })),
};
---

<Layout title={t.title} description={t.description} jsonLd={jsonLd}>
  <main class="stagger grid gap-12">
    <article class="grid gap-4">
      <PageHeader title={t.title} meta={t.meta} />
      {t.body.map((paragraph) => <p class="text-pretty">{paragraph}</p>)}
    </article>

    {
      localizedRoles.map((role) => (
        <section class="grid gap-4">
          <h2 class="section-title">{role.company}</h2>
          <div class="grid gap-1">
            <p class="font-semibold">{role.role}</p>
            <p class="text-faint">
              {role.period} · {role.location}
            </p>
          </div>
          <p class="text-pretty">{role.summary}</p>
          <div class="prose text-muted-foreground">
            <ul>
              {role.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
          </div>
        </section>
      ))
    }
  </main>
</Layout>
