---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import IndexList from "../components/IndexList.astro";
import EmailLink from "../components/EmailLink.astro";
import { contactLinks } from "../data/portfolio";
import { absoluteUrl, buildPersonSchema, siteConfig } from "../lib/seo";
import { getLocale, localizePath, useTranslations } from "../i18n";

const locale = getLocale(Astro.currentLocale);
const i18n = useTranslations(locale);
const t = i18n.contact;
const pageUrl = absoluteUrl(localizePath("/contact", locale), Astro.site);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: `${t.title} · ${siteConfig.name}`,
  description: t.description,
  url: pageUrl,
  mainEntity: buildPersonSchema(Astro.site),
};
---

<Layout title={t.title} description={t.description} jsonLd={jsonLd}>
  <main class="stagger grid gap-12">
    <article class="grid gap-4">
      <PageHeader title={t.title} meta={t.meta} />
      <p class="text-pretty">{t.body}</p>
      <EmailLink />
      <p class="text-pretty">
        {t.call[0]}<a href="https://cal.com/milind/15min">{t.book}</a>{
          t.call[1]
        }
      </p>
    </article>

    <section class="grid gap-4">
      <h2 class="section-title">{t.abroad}</h2>
      <p class="text-pretty">
        {t.abroadBody(i18n.city, t.country, siteConfig.location.timezoneLabel)}
      </p>
    </section>

    <IndexList
      title={t.elsewhere}
      items={contactLinks.map((link) => ({
        href: link.href,
        title: link.label,
        meta: t.links[link.label] ?? link.copy,
        external: true,
        attrs: { "data-contact-label": link.label },
      }))}
    />
  </main>
</Layout>

<script is:inline>
  document.querySelectorAll("[data-contact-label]").forEach((link) => {
    link.addEventListener("click", () => {
      window.posthog?.capture("contact_link_clicked", {
        platform: link.dataset.contactLabel,
        href: link.getAttribute("href"),
      });
    });
  });
</script>
