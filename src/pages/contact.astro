---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import IndexList from "../components/IndexList.astro";
import EmailLink from "../components/EmailLink.astro";
import { contactLinks } from "../data/portfolio";
import { absoluteUrl, buildPersonSchema, siteConfig } from "../lib/seo";

const pageUrl = absoluteUrl("/contact", Astro.site);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: `Contact · ${siteConfig.name}`,
  description: "Get in touch: email, GitHub, LinkedIn, or book a time.",
  url: pageUrl,
  mainEntity: buildPersonSchema(Astro.site),
};
---

<Layout
  title="Contact"
  description="Get in touch: email, GitHub, LinkedIn, or book a time."
  jsonLd={jsonLd}
>
  <main class="stagger grid gap-12">
    <article class="grid gap-4">
      <PageHeader
        title="Contact"
        meta="If the work needs product judgment and implementation discipline, I'd like to hear about it."
      />
      <p class="text-pretty">
        I'm most responsive on email and LinkedIn. If you have something
        interesting to discuss, I'd rather you send a detailed message than a
        generic introduction.
      </p>
      <EmailLink />
      <p class="text-pretty">
        Or <a href="https://cal.com/milind/15min">book 15 minutes</a> if a call is
        easier.
      </p>
    </article>

    <section class="grid gap-4">
      <h2 class="section-title">Working with teams abroad</h2>
      <p class="text-pretty">
        Based in {siteConfig.location.city}, {siteConfig.location.country} ({
          siteConfig.location.timezoneLabel
        }). I keep a 3–4 hour overlap with US mornings and most of the European
        workday, and I'm open to remote roles, B2B contractor, or EOR
        arrangements. Fluent in English.
      </p>
    </section>

    <IndexList
      title="Elsewhere"
      items={contactLinks.map((link) => ({
        href: link.href,
        title: link.label,
        meta: link.copy,
        external: true,
        attrs: { "data-contact-label": link.label },
      }))}
    />
  </main>
</Layout>

<script is:inline>
  document.querySelectorAll("[data-contact-label]").forEach((link) => {
    link.addEventListener("click", () => {
      window.posthog?.capture("contact_link_clicked", {
        platform: link.dataset.contactLabel,
        href: link.getAttribute("href"),
      });
    });
  });
</script>
