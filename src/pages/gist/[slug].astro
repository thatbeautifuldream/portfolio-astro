---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import CodeCopy from "../../components/CodeCopy.astro";
import PageHeader from "../../components/PageHeader.astro";
import { absoluteUrl, buildPersonRef } from "../../lib/seo";

export async function getStaticPaths() {
  const gists = await getCollection("gists");
  return gists.map((gist) => ({
    params: { slug: gist.id },
    props: { gist },
  }));
}

const { gist } = Astro.props;
const { Content } = await render(gist);

const date = gist.data.datePublished ?? gist.data.date ?? new Date(0);
const tag = gist.data.tags?.split(",")[0]?.trim() ?? "Gist";

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: gist.data.title,
  description: gist.data.description ?? "",
  author: buildPersonRef(Astro.site),
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
};
---

<Layout
  title={gist.data.title}
  description={gist.data.description ?? "Code snippets and quick solutions."}
  canonical={absoluteUrl(`/gist/${gist.id}`, Astro.site)}
  image={`/og/gist/${gist.id}.png`}
  jsonLd={jsonLd}
>
  <main>
    <article class="stagger grid min-w-0 gap-8">
      <PageHeader
        title={gist.data.title}
        meta={`${tag} · ${formatDate(date)}`}
      />
      <div class="grid gap-4">
        {
          gist.data.description && (
            <p class="text-muted-foreground text-pretty">
              {gist.data.description}
            </p>
          )
        }
        <p>
          <a href={gist.data.gistUrl} target="_blank" rel="noopener noreferrer"
            >View on GitHub</a
          >
        </p>
      </div>
      <div class="prose min-w-0">
        <Content />
      </div>
    </article>
  </main>
  <CodeCopy />
</Layout>
