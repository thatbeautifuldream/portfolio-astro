---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import IndexList from "../../components/IndexList.astro";
import { absoluteUrl, buildPersonRef, siteConfig } from "../../lib/seo";

function gistDate(data: { datePublished?: Date; date?: Date }): Date {
  return data.datePublished ?? data.date ?? new Date(0);
}

const gists = (await getCollection("gists")).sort(
  (a, b) => gistDate(b.data).getTime() - gistDate(a.data).getTime(),
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: `${siteConfig.shortName} - Gists`,
  description: "Code snippets and quick solutions.",
  url: absoluteUrl("/gist", Astro.site),
  author: buildPersonRef(Astro.site),
};
---

<Layout
  title="Gists"
  description="Code snippets and quick solutions."
  jsonLd={jsonLd}
>
  <main class="stagger grid gap-12">
    <PageHeader title="Gists" meta="Code snippets and quick solutions." />
    <IndexList
      title="Snippets"
      items={gists.map((gist) => {
        const date = gist.data.datePublished ?? gist.data.date;
        return {
          href: `/gist/${gist.id}`,
          title: gist.data.title,
          meta: date
            ? date.toLocaleDateString("en-GB", {
                day: "2-digit",
                month: "2-digit",
              })
            : gist.data.tags?.split(",")[0]?.trim(),
          group: date ? String(date.getFullYear()) : undefined,
          attrs: { "data-gist-title": gist.data.title },
        };
      })}
    />
  </main>
</Layout>

<script is:inline>
  document.querySelectorAll('a[href^="/gist/"]').forEach((link) => {
    link.addEventListener("click", () => {
      window.posthog?.capture("gist_clicked", {
        gist_slug: link.getAttribute("href").replace("/gist/", ""),
        gist_title: link.dataset.gistTitle ?? null,
      });
    });
  });
</script>
