---
import { execSync } from "node:child_process";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import wavingHand from "../assets/emojis/waving-hand.webp";
import merlin from "../assets/emojis/merlin.webp";
import cityscape from "../assets/emojis/cityscape.png";
import jsonVisualiser from "../assets/icons/json-visualiser.png";
import markdownVisualizer from "../assets/icons/markdown-visualizer.png";
import IndexList from "../components/IndexList.astro";
import GitHubChart from "../components/GitHubChart.astro";
import {
  contactEmail,
  hostname,
  roles,
  siteLinks,
  talks,
} from "../data/portfolio";
import {
  buildOrganizationSchema,
  buildPersonSchema,
  buildProfilePageSchema,
  buildWebsiteSchema,
  siteConfig,
} from "../lib/seo";

const projects = (await getCollection("projects")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const gists = await getCollection("gists");

let updated = new Date();
try {
  updated = new Date(execSync("git log -1 --format=%cI").toString().trim());
} catch {}

const dayMonth = (date: Date) =>
  date.toLocaleDateString("en-GB", { day: "2-digit", month: "2-digit" });
const years = (period: string) => {
  const [from, to] = period.split(" to ");
  const start = from!.slice(-4);
  const end = to === "present" ? "now" : to!.slice(-4);
  return start === end ? start : `${start} – ${end}`;
};

// Homepage uses the ProfilePage + Person + WebSite trio — Google's
// recommended combo for personal sites, which drives the Knowledge Panel
// and gives AI assistants a clear "this is a person" entity to cite.
const jsonLd = [
  buildProfilePageSchema(Astro.site),
  buildPersonSchema(Astro.site),
  buildOrganizationSchema(Astro.site),
  buildWebsiteSchema(Astro.site),
];
---

<Layout
  title={siteConfig.name}
  description={siteConfig.description}
  jsonLd={jsonLd}
>
  <main class="stagger grid gap-12">
    <article class="grid gap-8">
      <header class="grid gap-4">
        <p class="text-faint">
          Updated {
            updated.toLocaleDateString("en-US", {
              month: "short",
              day: "numeric",
              year: "numeric",
            })
          }
        </p>
        <h1 class="text-3xl font-medium tracking-tight text-pretty sm:text-4xl">
          <span class="text-faint">Hi</span>
          <Image
            src={wavingHand}
            alt=""
            width={96}
            class="wave inline-block size-[0.9em] align-[-0.1em]"
          />
          <span class="text-faint">I'm</span> Milind.
          <span class="text-faint">I build the part of software</span> a person actually
          feels.
        </h1>
      </header>
      <div class="grid gap-4 text-base/7 sm:text-sm/6">
        <p class="text-pretty">
          Product engineer at <a
            href="https://www.getmerlin.in/chat"
            class="chip"><Image src={merlin} alt="" width={40} />Merlin AI</a
          > in <span class="chip"
            ><Image src={cityscape} alt="" width={40} />{
              siteConfig.location.city
            }</span
          >. 130+ releases across mobile, desktop and web, and a coding agent
          from zero to v1.0 in two weeks.
        </p>
        <p class="text-pretty">
          My work has reached 2m+ people across five 0-to-1 products, and I
          build tools I use every day, like <a
            href="/project/json-visualiser"
            class="chip"
            ><Image src={jsonVisualiser} alt="" width={40} />JSON Visualiser</a
          > and <a href="/project/markdown-visualizer" class="chip"
            ><Image src={markdownVisualizer} alt="" width={40} />Markdown
            Visualizer</a
          >.
        </p>
        <p class="text-pretty">
          Next, I'm heading into design engineering. Find me on <a
            href={siteLinks.github.href}
            class="chip"><Icon name="ri:github-fill" />GitHub</a
          >, <a href={siteLinks.linkedin.href} class="chip"
            ><Icon name="ri:linkedin-box-fill" />LinkedIn</a
          > and <a href={siteLinks.x.href} class="chip"
            ><Icon name="ri:twitter-x-fill" />X</a
          >, read my <a href={siteLinks.resume.pdf} class="chip"
            ><Icon name="ri:file-text-line" />résumé</a
          >, <a href="https://cal.com/milind/15min" class="chip"
            ><Icon name="ri:calendar-line" />book 15 minutes</a
          >, or <a href={`mailto:${contactEmail}`} class="chip"
            ><Icon name="ri:mail-line" />email me</a
          >.
        </p>
      </div>
    </article>

    <IndexList
      title="Projects"
      items={projects.map((project) => ({
        href: `/project/${project.id}`,
        title: project.data.title,
        meta: hostname(project.data.url),
      }))}
    />

    <IndexList
      title="Writing"
      items={posts.map((post) => ({
        href: `/blog/${post.id}`,
        title: post.data.title,
        meta: dayMonth(post.data.date),
        group: String(post.data.date.getFullYear()),
      }))}
    />

    <IndexList
      title="Work"
      items={roles.map((role) => ({
        href: "/work",
        title: role.company,
        meta: years(role.period),
      }))}
    />

    <GitHubChart />

    <IndexList
      title="Talks"
      items={talks.map((talk) => ({
        href: talk.href,
        title: talk.title,
        meta: talk.date.slice(-4),
        external: true,
      }))}
    />

    <IndexList
      title="More"
      items={[
        { href: "/gist", title: "Gists", meta: `${gists.length} snippets` },
        { href: "/uses", title: "Uses", meta: "Tools I rely on" },
        { href: "/about", title: "About", meta: "The longer version" },
        { href: "/contact", title: "Contact", meta: "Say hello" },
        { href: "/docs", title: "API", meta: "OpenAPI docs" },
        { href: "/llms.txt", title: "Agent context", meta: "llms.txt" },
      ]}
    />
  </main>
</Layout>
