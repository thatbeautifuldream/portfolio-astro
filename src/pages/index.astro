---
import { execSync } from "node:child_process";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import IndexList from "../components/IndexList.astro";
import { contactEmail, roles, siteLinks, talks } from "../data/portfolio";
import {
  buildOrganizationSchema,
  buildPersonSchema,
  buildProfilePageSchema,
  buildWebsiteSchema,
  siteConfig,
} from "../lib/seo";

// Products are sourced from the same collection that powers /shotty and
// /murmur, so the homepage list never drifts from the product pages.
const products = (await getCollection("products")).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const gists = await getCollection("gists");

let updated = new Date();
try {
  updated = new Date(execSync("git log -1 --format=%cI").toString().trim());
} catch {}

const dayMonth = (date: Date) =>
  date.toLocaleDateString("en-GB", { day: "2-digit", month: "2-digit" });
const years = (period: string) => {
  const [from, to] = period.split(" to ");
  const start = from!.slice(-4);
  const end = to === "present" ? "now" : to!.slice(-4);
  return start === end ? start : `${start} – ${end}`;
};

// Homepage uses the ProfilePage + Person + WebSite trio — Google's
// recommended combo for personal sites, which drives the Knowledge Panel
// and gives AI assistants a clear "this is a person" entity to cite.
const jsonLd = [
  buildProfilePageSchema(Astro.site),
  buildPersonSchema(Astro.site),
  buildOrganizationSchema(Astro.site),
  buildWebsiteSchema(Astro.site),
];
---

<Layout
  title={siteConfig.name}
  description={siteConfig.description}
  jsonLd={jsonLd}
>
  <main class="stagger grid gap-12">
    <article class="grid gap-4">
      <PageHeader
        title={siteConfig.name}
        meta={`Updated ${updated.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}`}
      />
      <p class="text-pretty">
        I live in {siteConfig.location.city}, {siteConfig.location.country}, and
        work as a product engineer at <a
          href="https://www.getmerlin.in/chat"
          target="_blank"
          rel="noopener noreferrer">Merlin AI</a
        >, across the browser agent extension and Merlin's chat interface, where
        ambient AI meets everyday workflows.
      </p>
      <p class="text-pretty">
        I'm moving toward design engineering, where craft and code meet at the
        surface. I build agentic flows, design systems, and interaction-heavy
        surfaces, and I'm sharpening my design intuition through close study of
        the people and work I admire.
      </p>
      <p class="text-pretty">
        So far that's meant products used by 2m+ people, five of them shipped
        from 0 to 1, and a few <a href="/talks">talks</a> at React communities.
      </p>
      <p class="text-pretty">
        You can find me on <a
          href={siteLinks.github.href}
          target="_blank"
          rel="noopener noreferrer">GitHub</a
        >, <a
          href={siteLinks.linkedin.href}
          target="_blank"
          rel="noopener noreferrer">LinkedIn</a
        > and <a
          href={siteLinks.x.href}
          target="_blank"
          rel="noopener noreferrer">X</a
        >, read my <a href={siteLinks.resume.pdf}>résumé</a>, <a
          href="https://cal.com/milind/15min">book 15 minutes</a
        >, or reach me via <a href={`mailto:${contactEmail}`}>email</a>.
      </p>
    </article>

    <IndexList
      title="Writing"
      items={posts.map((post) => ({
        href: `/blog/${post.id}`,
        title: post.data.title,
        meta: dayMonth(post.data.date),
        group: String(post.data.date.getFullYear()),
      }))}
    />

    <IndexList
      title="Products"
      items={products.map((product) => ({
        href: `/${product.id}`,
        title: product.data.name,
        meta: product.data.platforms.join(" · "),
        attrs: {
          "data-product-id": product.id,
          "data-product-name": product.data.name,
        },
      }))}
    />

    <IndexList
      title="Work"
      items={roles.map((role) => ({
        href: "/work",
        title: role.company,
        meta: years(role.period),
      }))}
    />

    <IndexList
      title="Talks"
      items={talks.map((talk) => ({
        href: talk.href,
        title: talk.title,
        meta: talk.date.slice(-4),
        external: true,
      }))}
    />

    <IndexList
      title="More"
      items={[
        { href: "/gist", title: "Gists", meta: `${gists.length} snippets` },
        { href: "/uses", title: "Uses", meta: "Tools I rely on" },
        { href: "/about", title: "About", meta: "The longer version" },
        { href: "/contact", title: "Contact", meta: "Say hello" },
        { href: "/docs", title: "API", meta: "OpenAPI docs" },
        { href: "/llms.txt", title: "Agent context", meta: "llms.txt" },
      ]}
    />
  </main>
</Layout>

<script is:inline>
  document.querySelectorAll("[data-product-id]").forEach((link) => {
    link.addEventListener("click", () => {
      window.posthog?.capture("product_clicked", {
        product_id: link.dataset.productId,
        product_name: link.dataset.productName,
      });
    });
  });
</script>
