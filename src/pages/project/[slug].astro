---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import CodeCopy from "../../components/CodeCopy.astro";
import PageHeader from "../../components/PageHeader.astro";
import { hostname } from "../../data/portfolio";
import { absoluteUrl, buildPersonRef } from "../../lib/seo";
import { getLocale, localizePath } from "../../i18n";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const locale = getLocale(Astro.currentLocale);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: project.data.title,
  description: project.data.description,
  url: project.data.url,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Web",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: buildPersonRef(Astro.site),
};
---

<Layout
  title={project.data.title}
  description={project.data.description}
  canonical={absoluteUrl(
    localizePath(`/project/${project.id}`, locale),
    Astro.site,
  )}
  image={`/og/project/${project.id}.png`}
  jsonLd={jsonLd}
>
  <main>
    <article class="stagger grid min-w-0 gap-8">
      <PageHeader title={project.data.title} meta={project.data.description}>
        <a
          href={project.data.url}
          class="text-faint hover:text-foreground inline-flex w-fit items-center gap-1 no-underline"
        >
          {hostname(project.data.url)}
          <Icon
            name="ri:arrow-right-up-line"
            class="size-5 shrink-0 sm:size-4"
          />
        </a>
      </PageHeader>
      <div class="prose min-w-0">
        <Content />
      </div>
    </article>
  </main>
  <CodeCopy />
</Layout>
